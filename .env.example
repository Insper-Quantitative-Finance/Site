# ---------------------------------------------------------------- Supabase
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave service_role. NUNCA vai para o navegador nem para o git.
# É ela que permite criar usuários e ignorar o RLS no servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------- Instagram
# Token de longa duração da Graph API (60 dias). Veja o README.
INSTAGRAM_ACCESS_TOKEN=
# Preencha SÓ no fluxo de Facebook Login (conta Business ligada a uma Página).
# Deixe vazio no fluxo de Instagram Login.
INSTAGRAM_USER_ID=

# ----------------------------------------------------------------- E-mail
# Envio dos convites pelo Gmail da liga, via SMTP.
# Sem estas duas, convidar continua funcionando (o link sai na tela, e há um
# botão que abre sua caixa com a mensagem pronta); só o disparo em lote falha,
# e a tela de usuários avisa.
GMAIL_USER=insperqfc@gmail.com
# Conta Google → Segurança → Senhas de app. NÃO é a senha normal da conta:
# a normal não funciona em SMTP, e a de app dá para revogar sozinha se vazar.
# Exige verificação em duas etapas ligada na conta.
GMAIL_APP_PASSWORD=
# Nome exibido na caixa de entrada de quem recebe (opcional).
EMAIL_NOME=Insper Quantitative Finance

# ------------------------------------------------------------------- Cron
# Segredo do endpoint /api/instagram/atualizar. Gere com: openssl rand -hex 32
CRON_SECRET=
